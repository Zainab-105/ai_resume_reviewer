# Copy to .env.local and fill in. .env* is gitignored.

# --- Public: safe in the browser bundle ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used for OAuth + email redirects. Set to the production domain on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only: never prefix these with NEXT_PUBLIC_ -------------------
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional fallback provider
ANTHROPIC_API_KEY=
